# Copy to .env (gitignored) to override machine-specific paths without
# editing config/config.py. Every value here is optional — config.py has
# a working default for each.

# Absolute path to the GGUF quantized LLM weights
VESI_MODEL_PATH=/path/to/model/

# Where the chat history JSON is written. Defaults to <repo>/logs/chat_log.json
# VESI_MEMORY_PATH=/path/to/logs/

# Logging. INFO (default) is minimal: startup, one line per request, errors.
# DEBUG adds stage timings and dumps the full prompt, response and mood detail.
# VESI_LOG_LEVEL=DEBUG

# Set to 1 to also write logs/vesi_<timestamp>.log — a fresh file each session.
# VESI_LOG_FILE=1